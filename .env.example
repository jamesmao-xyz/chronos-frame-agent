# Chronos Smart Frame Environment Configuration

# 1. Google Cloud Vertex AI & ADC Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Path to the local OAuth ADC credentials file (from `gcloud auth application-default login`)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Explicitly route Google GenAI calls through Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true

# (Optional: Leave empty if using ADC)
# GEMINI_API_KEY=

# 2. Server & Slideshow Configuration
PORT=8080
SCHEDULE_INTERVAL_SECONDS=900
ROTATION_INTERVAL_SECONDS=300
